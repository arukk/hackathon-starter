# ─────────────────────────────────────────────────────────────
# Hackathon Starter — copy to .env.local and fill what you need.
# The app runs with ZERO of these set (demo auth mode).
# Each section flips its dashboard card to "Connected" when set.
# ─────────────────────────────────────────────────────────────

# ── Supabase (auth + database) ───────────────────────────────
# Setting NEXT_PUBLIC_SUPABASE_URL switches login from demo accounts
# to real Supabase auth. Get both values from:
# Supabase Dashboard → Project Settings → API
# Note: Supabase requires passwords ≥ 6 chars — the demo "123" works
# only in demo mode (see HACKATHON.md → Connect Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Demo session signing ─────────────────────────────────────
# Signs the demo_session cookie. Optional for local dev (a dev
# fallback is used); SET THIS for any deployed demo instance.
DEMO_SESSION_SECRET=

# ── AI (any OpenAI-compatible endpoint) ──────────────────────
# Works with OpenAI, Groq, OpenRouter, Together, local Ollama, …
AI_API_KEY=
# Optional overrides:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Firebase (client SDK: auth, Firestore, FCM) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── MCP (Model Context Protocol) ─────────────────────────────
# URL of an external MCP server this app can call as a client.
MCP_SERVER_URL=
# Optional bearer token:
# MCP_SERVER_TOKEN=

# ── Webhooks ─────────────────────────────────────────────────
# Shared HMAC-SHA256 secret for inbound verification AND outbound
# signing (X-Webhook-Signature header).
WEBHOOK_SECRET=
# Optional default target for outbound webhooks:
# OUTGOING_WEBHOOK_URL=
